{
  "name": "only-chat",
  "displayName": "Only Chat",
  "description": "A focused AI chat panel for VS Code",
  "version": "1.3.0",
  "icon": "resources/logo.png",
  "license": "MIT",
  "publisher": "huanent",
  "repository": {
    "type": "github",
    "url": "https://github.com/huanent/vscode-only-chat"
  },
  "homepage": "https://github.com/huanent/vscode-only-chat",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "AI"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "onlyChat.editor",
        "displayName": "Only Chat",
        "selector": [
          {
            "filenamePattern": "*.only-chat"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "onlyChat.open",
        "title": "Open Chat",
        "category": "Only Chat"
      },
      {
        "command": "onlyChat.newConversation",
        "title": "New Chat",
        "category": "Only Chat"
      },
      {
        "command": "onlyChat.newTab",
        "title": "New Chat Tab",
        "category": "Only Chat"
      }
    ],
    "keybindings": [
      {
        "command": "onlyChat.open",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i"
      },
      {
        "command": "onlyChat.newConversation",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "activeCustomEditorId == onlyChat.editor && onlyChat.webviewFocus"
      },
      {
        "command": "onlyChat.newTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeCustomEditorId == onlyChat.editor && onlyChat.webviewFocus"
      }
    ],
    "configuration": {
      "title": "Only Chat",
      "properties": {
        "onlyChat.prompt": {
          "type": "string",
          "default": "",
          "markdownDescription": "The prompt used for conversations.",
          "scope": "window"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "rimraf out && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "vscode-test",
    "publish": "vsce publish",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "dompurify": "^3.4.12",
    "katex": "^0.18.1",
    "markdown-it": "^14.3.0",
    "markdown-it-texmath": "^1.0.0",
    "prismjs": "^1.30.0"
  }
}
